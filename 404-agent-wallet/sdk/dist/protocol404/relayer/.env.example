# BSC testnet first. Never commit a real key or private RPC URL.
RELAYER_CHAIN_ID=97
RELAYER_RPC_URL=https://your-bsc-testnet-rpc.example
RELAYER_PRIVATE_KEY=0xYOUR_64_HEX_PRIVATE_KEY
RELAYER_POOL=0xYOUR_404_POOL
RELAYER_POOL_PROFILE=404
RELAYER_MARKET=0xYOUR_404_MARKET
RELAYER_MARKET_PROFILE=404
RELAYER_MARKET_VERSION=1
# Required to enable GET /trades and /trades/stats. Use the market deployment block.
# RELAYER_MARKET_BLOCK=123456
RELAYER_MINT=0xYOUR_404_MINT
RELAYER_BUNDLE=0xYOUR_404_BUNDLE

RELAYER_HOST=127.0.0.1
RELAYER_PORT=8787
RELAYER_TOKEN_FEE=1000000000
RELAYER_NATIVE_FEE=10000
# Public service default: quoted gas budget × chosen gas price + fixed 5%.
RELAYER_FEE_MODE=gas-plus
RELAYER_GAS_CAP=12000000
RELAYER_MAX_CONCURRENT=4
RELAYER_RESERVATION_MS=180000
RELAYER_BODY_LIMIT=262144
